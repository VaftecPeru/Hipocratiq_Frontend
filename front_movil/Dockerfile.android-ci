FROM mobiledevops/android-sdk-image:36.1.0

USER root

ARG FLUTTER_VERSION=3.44.4

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git libglu1-mesa unzip xz-utils zip \
    && rm -rf /var/lib/apt/lists/*

RUN java -version \
    && test -n "${ANDROID_SDK_ROOT:-}" \
    && yes | "$ANDROID_HOME/cmdline-tools/bin/sdkmanager" --sdk_root="$ANDROID_SDK_ROOT" --licenses >/dev/null \
    && "$ANDROID_HOME/cmdline-tools/bin/sdkmanager" --sdk_root="$ANDROID_SDK_ROOT" \
      "platform-tools" "platforms;android-37" "build-tools;37.0.0"

ENV FLUTTER_HOME=/opt/flutter
ENV PATH="${FLUTTER_HOME}/bin:${FLUTTER_HOME}/bin/cache/dart-sdk/bin:${PATH}"

RUN mkdir -p "${FLUTTER_HOME}" \
    && curl --fail --location --retry 5 \
      "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
      -o /tmp/flutter.tar.xz \
    && tar -xJf /tmp/flutter.tar.xz -C "${FLUTTER_HOME}" --strip-components=1 \
    && rm /tmp/flutter.tar.xz \
    && git config --global --add safe.directory "${FLUTTER_HOME}" \
    && flutter config --no-analytics \
    && flutter precache --android

WORKDIR /workspace

COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .

CMD ["flutter", "--version"]
